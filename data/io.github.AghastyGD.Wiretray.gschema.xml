<?xml version="1.0" encoding="UTF-8"?>

<schemalist>
  <schema 
    id="io.github.AghastyGD.Wiretray"
    path="/io/github/AghastyGD/Wiretray/">    
    
    <key name="ssid" type="s">
      <default>''</default>
      <summary>Hotspot SSID</summary>
    </key>

    <key name="passphrase" type="s">
      <default>''</default>
      <summary>Hotspot passphrase</summary>
    </key>

    <key name="hotspot-backend" type="s">
      <default>'network-manager'</default>
      <summary>Hotspot mode</summary>
      <description>Controls whether the hotspot uses standard mode or keeps the current internet connection active</description>
    </key>
  </schema>
</schemalist>
