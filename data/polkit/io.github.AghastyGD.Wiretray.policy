<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
  "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Wiretray</vendor>
  <vendor_url>https://github.com/aghastygd/wiretray</vendor_url>

  <action id="io.github.AghastyGD.Wiretray.concurrent-ap">
    <description>Manage concurrent hotspot networking</description>
    <message>Authentication is required to manage the concurrent hotspot</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/wiretray/wiretray-helper</annotate>
  </action>
</policyconfig>
